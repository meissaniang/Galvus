{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galvus",
  "version": "0.1.0",
  "identifier": "com.galvus.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Galvus",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/galvus/releases/latest/download/latest.json"
      ],
      "pubkey": "REMPLACER_PAR_LA_CLE_PUBLIQUE_TAURI_SIGNER"
    }
  }
}
